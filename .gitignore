# Vendored third-party sources are TRACKED (vendored by commit) so a fresh clone +
# CI's actions/checkout build with NO fetch step. cglm, lodepng, parson (source/)
# and m-lib, greatest (third_party/) all carry permissive licenses with their
# LICENSE.* files. RECONCILED 2026-06-19: the earlier "Removed some unneeded files"
# commit had dropped + ignored these build deps, silently breaking every fresh-clone
# and CI fresh-checkout build (cglm.h not found) -- re-vendored to match the upstream
# CavEX convention and the cNBT precedent above.
# third_party: ignore the CONTENTS, then re-include the vendored libs explicitly
# (git can't re-include a path whose parent dir is wholesale-excluded).
/third_party/*
!/third_party/greatest/
!/third_party/m-lib/
!/third_party/stb/
!/third_party/miniaudio/
!/third_party/libogc-kernel-heap/

# Build outputs (devkitPro + CMake). Both dash and underscore build-directory
# conventions exist in local verification scripts.
/build/
/build-*/
/build_*/
/tools/wii_stage_server/build/
/tools/pack_helper/resources/

# Built artifacts (anywhere in the tree)
*.dol
*.elf
*.zip
*.tpl
*.o
*.d
*.map

# IDE and Codex local state
.settings/org.eclipse.cdt.core.prefs
/.codex-remote-attachments/

