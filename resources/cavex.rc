// PC app icon: the CAVEX logo-A wordmark (maintainer 10-30/11-01), same art as the
// Asset Importer icon (tools/pack_helper/art/computer.ico). GLFW_ICON is the name
// GLFW loads for the window and taskbar icon on Windows.
GLFW_ICON ICON "cavex.ico"

// Keep these versions in sync with the repository VERSION file (0.1.1).
1 VERSIONINFO
FILEVERSION 0,1,1,0
PRODUCTVERSION 0,1,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "CavEX: ReCrafted"
            VALUE "ProductName", "CavEX: ReCrafted"
            VALUE "InternalName", "CavEX-ReCrafted"
            VALUE "OriginalFilename", "CavEX-ReCrafted.exe"
            VALUE "FileVersion", "0.1.1"
            VALUE "ProductVersion", "0.1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
