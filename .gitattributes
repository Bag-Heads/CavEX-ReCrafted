# Normalize line endings across all platforms.
#
# `text=auto` lets git auto-detect text vs. binary on each file.
# `eol=lf` forces the in-repo blob to use LF, regardless of what the
# checked-out working tree uses. Windows clones still get CRLF in their
# working tree via core.autocrlf=true (the default on Windows installs);
# Linux/macOS clones get LF natively. This eliminates the 36,836-line
# phantom diff that was haunting the repo.
#
# Run `git add --renormalize .` after editing this file to apply the
# normalization to existing tracked content.

* text=auto eol=lf

# Force binary so git never tries to munge these.
*.png binary
*.dol binary
*.elf binary
*.zip binary
*.tpl binary
*.scf binary
*.bin binary
*.raw binary
*.ico binary
*.bmp binary

# Force LF on shell scripts and Makefiles (which break with CRLF).
*.sh   text eol=lf
Makefile text eol=lf
*.mk   text eol=lf

# Windows-only files keep CRLF so cmd.exe and Notepad don't choke.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

