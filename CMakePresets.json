{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "PC dev (fast iteration: no IPO, tests on)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-pcdev",
      "cacheVariables": { "BUILD_TESTING": "ON", "CAVEX_IPO": "OFF" }
    },
    {
      "name": "verify",
      "displayName": "Full verify (mirrors tools/ci.sh test leg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-verify",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CAVEWII_REQUIRE_TEST_TOOLS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan+UBSan soak build (Linux/WSL only)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "SANITIZE": "ON",
        "CAVEX_IPO": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "OFF"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "pc-release",
      "displayName": "PC release app (IPO on, no tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "verify", "configurePreset": "verify" },
    { "name": "asan", "configurePreset": "asan", "targets": ["soak_stream"] },
    { "name": "pc-release", "configurePreset": "pc-release", "targets": ["cavex"] }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8 }
    },
    {
      "name": "verify",
      "configurePreset": "verify",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8 }
    }
  ]
}
